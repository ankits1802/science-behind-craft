    "code": "<style>\n.cf{display:grid;gap:12px;font-family:var(--font-ui);color:var(--ink-1)}\n.cf svg{display:block;width:100%;height:auto}\n.cf-bar{display:flex;flex-wrap:wrap;gap:12px;align-items:center}\n.cf-status{margin:0;font-size:13px;color:var(--ink-2)}\n.cf-key{margin:0;padding:0;list-style:none;display:flex;flex-wrap:wrap;gap:4px 16px;font-size:13px;color:var(--ink-2)}\n.cf .salt,.cf .piece{transition:transform 1s ease-in-out}\n.cf[data-step=weighed] .salt{transform:translateY(-48px)}\n.cf[data-step=weighed] .piece,.cf[data-step=dissolved] .piece{transform:translateY(-64px);fill:var(--raised)}\n</style>\n<div class=\"cf\">\n<svg viewBox=\"0 0 320 200\" role=\"img\" data-unit-label=\"alt\">\n<path d=\"M100 40 L100 180 L220 180 L220 40\" fill=\"none\" stroke=\"var(--ink-1)\" stroke-width=\"2\"/>\n<rect class=\"cf-water\" x=\"102\" y=\"100\" width=\"116\" height=\"80\" fill=\"var(--sunk)\"/>\n<path d=\"M102 100 Q131 94 160 100 T218 100\" fill=\"none\" stroke=\"var(--ink-2)\"/>\n<rect class=\"salt heap-ammonium\" x=\"30\" y=\"140\" width=\"40\" height=\"40\" fill=\"var(--raised)\" stroke=\"var(--ink-2)\"/>\n<rect class=\"salt heap-nitrate\" x=\"250\" y=\"170\" width=\"40\" height=\"10\" fill=\"var(--raised)\" stroke=\"var(--ink-2)\"/>\n<line x1=\"160\" y1=\"24\" x2=\"160\" y2=\"110\" stroke=\"var(--ink-3)\"/>\n<rect class=\"piece\" x=\"140\" y=\"110\" width=\"40\" height=\"48\" fill=\"var(--ink-1)\" stroke=\"var(--ink-1)\"/>\n<text x=\"160\" y=\"16\" text-anchor=\"middle\" font-size=\"12\" fill=\"var(--ink-2)\">Bidri alloy</text>\n<text x=\"50\" y=\"196\" text-anchor=\"middle\" font-size=\"12\" fill=\"var(--ink-2)\">Salt</text>\n<text x=\"270\" y=\"196\" text-anchor=\"middle\" font-size=\"12\" fill=\"var(--ink-2)\">Salt</text>\n</svg>\n<ul class=\"cf-key\"><li data-unit=\"ammonium\"></li><li data-unit=\"nitrate\"></li><li data-unit=\"water\"></li></ul>\n<div class=\"cf-bar\">\n<button class=\"cf-play\" type=\"button\" aria-pressed=\"false\">Play</button>\n<p class=\"cf-status\" role=\"status\" aria-live=\"polite\" data-unit=\"patina\"></p>\n</div>\n</div>\n<script>\n(function () {\nconst data = JSON.parse(document.getElementById(\"kv-data\").textContent);\nconst figure = document.querySelector(\".cf\");\nconst play = document.querySelector(\".cf-play\");\nconst status = document.querySelector(\".cf-status\");\nconst still = document.documentElement.dataset.reducedMotion === \"true\";\nconst steps = [\"weighed\", \"dissolved\", \"patina\"];\nlet step = 2;\nlet timer = 0;\nconst heap = function (name, grams) {\nconst shape = document.querySelector(\".heap-\" + name);\nshape.setAttribute(\"height\", String(grams * 2));\nshape.setAttribute(\"y\", String(180 - grams * 2));\n};\nheap(\"ammonium\", data.ammonium);\nheap(\"nitrate\", data.nitrate);\nconst water = document.querySelector(\".cf-water\");\nwater.setAttribute(\"height\", String(data.water * 0.8));\nwater.setAttribute(\"y\", String(180 - data.water * 0.8));\nconst show = function (next) {\nstep = next;\nfigure.dataset.step = steps[next];\nstatus.dataset.unit = steps[next];\n};\nconst stop = function () {\nclearTimeout(timer);\nplay.setAttribute(\"aria-pressed\", \"false\");\nplay.textContent = \"Play\";\nshow(2);\n};\nconst run = function () {\nif (step >= 2) {\nstop();\nreturn;\n}\ntimer = setTimeout(function () {\nshow(step + 1);\nrun();\n}, 1000);\n};\nplay.addEventListener(\"click\", function () {\nif (play.getAttribute(\"aria-pressed\") === \"true\") {\nstop();\nreturn;\n}\nif (still) {\nshow(step >= 2 ? 0 : step + 1);\nreturn;\n}\nplay.setAttribute(\"aria-pressed\", \"true\");\nplay.textContent = \"Pause\";\nshow(0);\nrun();\n});\n})();\n</script>",
