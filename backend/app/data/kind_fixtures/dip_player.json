  "facts": {
    "C071": {
      "text": "The finished article is dipped in a boiling solution of fort earth and ammonium chloride, which turns the zinc alloy black while the silver keeps its colour.",
      "quotes": [
        {
          "source": "S02",
          "locator": "lines 296-299",
          "quote": "The polished article is then dipped in a boiled solution of ammonium chloride and earth collected and available only from the fort area"
        },
        {
          "source": "S02",
          "locator": "lines 305-307",
          "quote": "By this process, the zinc portion ofthe articles become black and the silver portion retains its own colour."
        },
        {
          "source": "S03",
          "locator": "lines 1348-1349",
          "quote": "The finished article is now given a dip in this hot solution."
        },
        {
          "source": "S03",
          "locator": "lines 1350-1351",
          "quote": "The zinc alloy turns permanently jet black while the silver retains its brilliance."
        }
      ]
    },
    "C077": {
      "text": "The blackened piece is polished with groundnut oil, in some accounts as a paste with fine charcoal powder, to give it a shine.",
      "quotes": [
        {
          "source": "S02",
          "locator": "lines 309-311",
          "quote": "Later the whole surface is rubbed with groundnut oil, so as to give the article a shining."
        },
        {
          "source": "S03",
          "locator": "lines 1356-1357",
          "quote": "For this purpose a paste of fine charcoal powder and ground nut oil is prepared."
        },
        {
          "source": "S14",
          "locator": "line 15",
          "quote": "Following this, the object is polished with groundnut oil and charcoal."
        }
      ]
    },
    "C117": {
      "text": "La Niece and Martin found that the black patina forms instantly when the alloy is immersed in a warm solution of one part potassium nitrate to four parts ammonium chloride.",
      "quotes": [
        {
          "source": "S05",
          "locator": "line 29",
          "quote": "The black patina forms instantaneously on immersion of the alloy in a warm solution of potassium nitrate (one part) and ammonium chloride (four parts)."
        }
      ]
    }
  },
