    },
    "u0002": {
      "text": "The black patina forms the instant the alloy enters the warm solution.",
      "claims": [
        "C117"
      ]
    },
    "u0003": {
      "text": "The silver inlay keeps its colour.",
      "claims": [
        "C071"
      ]
    },
    "u0004": {
      "text": "In the solution",
      "claims": []
    },
    "u0005": {
      "text": "In the bath",
      "claims": []
    },
    "u0006": {
      "text": "The finished article is dipped in a boiling solution of fort earth and ammonium chloride.",
      "claims": [
        "C071"
      ]
    },
    "u0007": {
      "text": "Lifted",
      "claims": []
    },
