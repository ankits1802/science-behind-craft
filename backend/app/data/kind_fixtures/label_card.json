    "C047": {
      "text": "The GI registry records Karnataka as the geographical area of the Bidriware geographical indication.",
      "quotes": [
        {
          "source": "S01",
          "locator": "line 10",
          "quote": "| Geographical Area | Karnataka |"
        }
      ]
    },
    "C134": {
      "text": "Bidriware is a registered geographical indication under application number 20, filed by the Karnataka State Handicrafts Development Corporation Limited on 24 January 2005.",
      "quotes": [
        {
          "source": "S01",
          "locator": "lines 2-5",
          "quote": "| Application Number | 20 | | Geographical Indications | Bidriware | | Status | Registered | | Applicant Name | Karnataka State Handicrafts Development Corporation Limited |"
        },
        {
          "source": "S01",
          "locator": "line 7",
          "quote": "| Date of Filing | 24-01-2005 |"
        }
      ]
    },
    "C135": {
      "text": "The registry issued certificate number 21 for Bidriware on 30 January 2006, after publication in Geographical Indications Journal number 10.",
      "quotes": [
        {
          "source": "S01",
          "locator": "lines 12-15",
          "quote": "| Journal Number | 10 | | Availability Date | 21-10-2005 | | Certificate Number | 21 | | Certificate Date | 30-01-2006 |"
        },
        {
          "source": "S16",
          "locator": "line 5",
          "quote": "In 2006, Bidriware was granted the Geographical Indications status by the Government of India."
        }
      ]
    },
    "C136": {
      "text": "The Bidriware geographical indication registration is valid up to 23 January 2035.",
      "quotes": [
        {
          "source": "S01",
          "locator": "line 16",
          "quote": "| Registration Valid Upto | 23-01-2035 |"
        }
      ]
    }
