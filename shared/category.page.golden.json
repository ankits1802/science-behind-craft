          "level": "PROVISIONAL"
        }
      ]
    },
    {
      "id": "8bef7a56-08a0-55d8-9044-21931407d209",
      "text": "The Kolhapuri GI application states that the chappal is made completely and exclusively from bag-tanned vegetable leather.",
      "level": "PROVISIONAL",
      "discipline": "MATERIALS",
      "sourcesDiffer": false,
