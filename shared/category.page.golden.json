        ]
      },
      {
        "id": "p6be467902b26.3",
        "text": "Chamar names a widespread caste of northern India whose hereditary occupation is tanning leather, and in the Kolhapuri trade the Dhors run the tanneries and the Chambhars make the chappals by hand.",
        "level": "PROVISIONAL",
        "claimIds": [
          "b67a7053-21da-5a82-a894-01e83820f989",
          "6db3e223-90e4-5c13-a142-31e0efc8cd12"
