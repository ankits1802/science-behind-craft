  "overview": {
    "lede": [
      {
        "id": "p6be467902b26.1",
        "text": "Leather is animal skin or hide that tanning, a chemical treatment with vegetable tannins, mineral salts such as chromium sulfate, or oils, converts from perishable skin into a stable, non-decaying material.",
        "level": "PROVISIONAL",
        "claimIds": [
          "852cafa2-a62b-50c3-ab6e-0af34744ff35",
          "9ae35f63-8f90-58dc-b549-133f27514bce",
          "89ea0d23-f1dc-5b3f-9ee7-ba8cacdf46d8"
        ],
        "terms": [],
        "subCategories": [],
        "crafts": []
      },
      {
        "id": "p6be467902b26.2",
        "text": "The category's footwear includes the bag-tanned Kolhapuri chappals of Maharashtra and Karnataka and the Chamba Chappal of Himachal Pradesh, and its other leather articles include Kanpur saddlery, Santiniketan leather goods and the leather shadow puppets of Andhra Pradesh and Karnataka.",
        "level": "PROVISIONAL",
        "claimIds": [
          "d5b92396-9e80-55b7-a9e3-5149d460814e",
          "8bef7a56-08a0-55d8-9044-21931407d209",
          "e72658cb-c4ad-5b00-a243-4e2e2be10d48",
          "31a90bd5-43a5-5657-9672-158134b552f7",
          "a3c39395-7f6e-5e2c-90ef-177fae6912fe",
          "006c72f8-9024-5bf2-8513-c64c3924db0a",
          "c729d5cb-745c-5e94-a4be-a2c04830e00f",
          "96b58cc2-6f9f-5eb8-a25a-034d3ee3c5b1"
        ],
        "terms": [],
        "subCategories": [
          "Leather-Footwear",
          "Leather-Other-Articles"
        ],
        "crafts": [
          "Kolhapuri-Chappal",
          "Chamba-Chappal",
          "Kanpur-Saddlery",
          "Santiniketan-Leather-Goods",
