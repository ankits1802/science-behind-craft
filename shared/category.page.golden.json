    {
      "id": "c729d5cb-745c-5e94-a4be-a2c04830e00f",
      "text": "Tholu bommalata, literally the dance of the leather puppets, is the shadow theatre tradition of Andhra Pradesh, Telangana and part of Karnataka.",
      "level": "PROVISIONAL",
      "discipline": "OVERVIEW",
      "sourcesDiffer": false,
      "citations": [
        {
          "id": "5e58dd33-511f-5ee8-ad85-13b79008b66e",
          "claimId": "c729d5cb-745c-5e94-a4be-a2c04830e00f",
          "sourceId": "b06ea566-d456-5676-9b88-4b43a3e52b9a",
          "quote": "literally means the dance (attam, ata) of the leather (tholu) puppets (bommalu)",
          "locator": "Introduction, para. 1",
          "context": null,
          "evidence": "QUOTED",
          "level": "PROVISIONAL"
        },
        {
          "id": "91f91f34-dc9d-5aa4-bc9d-6a1bd365eb08",
          "claimId": "c729d5cb-745c-5e94-a4be-a2c04830e00f",
