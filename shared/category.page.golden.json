          "level": "PROVISIONAL"
        },
        {
          "id": "c7dd05fe-6fb8-533f-a5a4-f8f359b28d3e",
          "claimId": "5b94d767-0b1a-5934-9584-c76ca35b34b2",
          "sourceId": "fe49376b-3023-5410-8394-a0c9e05cd5c2",
          "quote": "There are approximately 3,000 tanneries located along the Ganga River (Dwivedi et al. 2018). A cluster of around 400 tanneries can be found in Jajmau, Kanpur",
          "locator": "Introduction",
          "context": null,
          "evidence": "QUOTED",
          "level": "PROVISIONAL"
        }
      ]
