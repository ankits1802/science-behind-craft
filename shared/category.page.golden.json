  "claims": [
    {
      "id": "852cafa2-a62b-50c3-ab6e-0af34744ff35",
      "text": "Leather is animal skin or hide treated with chemicals to preserve it for use in clothing, footwear, handbags, furniture, tools and sports equipment.",
      "level": "PROVISIONAL",
      "discipline": "OVERVIEW",
      "sourcesDiffer": false,
      "citations": [
        {
          "id": "dcc2ec5d-ea48-5001-894a-d21f6e7193be",
          "claimId": "852cafa2-a62b-50c3-ab6e-0af34744ff35",
          "sourceId": "45c6bcdc-3d1e-5d21-b8f2-a0f35380157c",
          "quote": "animalskins and hides that have been treated with chemicals to preserve them and make them suitable for use as clothing, footwear, handbags, furniture, tools, and sports equipment.",
          "locator": "introduction",
          "context": null,
          "evidence": "QUOTED",
          "level": "PROVISIONAL"
        }
      ]
    },
    {
      "id": "9ae35f63-8f90-58dc-b549-133f27514bce",
      "text": "Tanning is the chemical treatment that converts otherwise perishable skin into a stable, non-decaying material, and it is the most important chemical step in leather making.",
      "level": "PROVISIONAL",
      "discipline": "OVERVIEW",
      "sourcesDiffer": false,
      "citations": [
        {
          "id": "01d04d3e-0e65-50c9-ac9f-1ad95ec2cffd",
          "claimId": "9ae35f63-8f90-58dc-b549-133f27514bce",
          "sourceId": "21a074d3-69da-54dd-9e0d-eca64e5d8daa",
          "quote": "the tanning process is the most important chemical process that converts animal skins into leather",
          "locator": "abstract",
          "context": null,
          "evidence": "QUOTED",
          "level": "PROVISIONAL"
        },
        {
          "id": "15c6cb3e-567a-54c3-8dd7-67355b051ea6",
          "claimId": "9ae35f63-8f90-58dc-b549-133f27514bce",
          "sourceId": "45c6bcdc-3d1e-5d21-b8f2-a0f35380157c",
          "quote": "The preservation process employed is a chemical treatment called tanning, which converts the otherwise perishable skin to a stable and nondecaying material.",
          "locator": "introduction",
          "context": null,
          "evidence": "QUOTED",
          "level": "PROVISIONAL"
        }
      ]
    },
    {
      "id": "89ea0d23-f1dc-5b3f-9ee7-ba8cacdf46d8",
      "text": "Tanning agents include vegetable tannins from sources such as tree bark, mineral salts such as chromium sulfate, and fish or animal oils.",
      "level": "PROVISIONAL",
      "discipline": "OVERVIEW",
      "sourcesDiffer": false,
      "citations": [
        {
          "id": "62edbd8e-a294-596b-8caf-b0039b69f6ef",
          "claimId": "89ea0d23-f1dc-5b3f-9ee7-ba8cacdf46d8",
          "sourceId": "45c6bcdc-3d1e-5d21-b8f2-a0f35380157c",
          "quote": "Tanning agents include vegetable tannins (from sources such as tree bark), mineral salts (such as chromiumsulfate), and fish or animal oils.",
          "locator": "introduction",
          "context": null,
          "evidence": "QUOTED",
          "level": "PROVISIONAL"
        }
      ]
    },
    {
      "id": "d5b92396-9e80-55b7-a9e3-5149d460814e",
      "text": "Kolhapuri chappals are handmade open footwear made of vegetable-tanned leather with traditional techniques and tools.",
      "level": "PROVISIONAL",
      "discipline": "OVERVIEW",
      "sourcesDiffer": false,
      "citations": [
        {
          "id": "9110b368-fd56-5a7f-ab7c-654d2e0b42d0",
          "claimId": "d5b92396-9e80-55b7-a9e3-5149d460814e",
          "sourceId": "bec1af2a-39e1-511b-a8d0-ed2cf24b4e95",
          "quote": "Kolhapuri Chappal are handmade open Indian footwear made of tanned vegetable leather produced using traditional technique and tools.",
