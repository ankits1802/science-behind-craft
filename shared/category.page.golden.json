    {
      "id": "96b58cc2-6f9f-5eb8-a25a-034d3ee3c5b1",
      "text": "Togalu gombeyata is a traditional shadow theatre of Karnataka whose name joins togalu, leather, with gombeyata, figure, doll, dance and performance.",
      "level": "PROVISIONAL",
      "discipline": "OVERVIEW",
      "sourcesDiffer": false,
      "citations": [
        {
          "id": "a661764a-a492-5b54-ba92-767caf5f50f7",
          "claimId": "96b58cc2-6f9f-5eb8-a25a-034d3ee3c5b1",
          "sourceId": "76991638-95ee-5014-aeca-33a1898f0bc7",
          "quote": "Traditional shadow theatre from Karnataka in south-west India. Togalu signifies \"leather\" and gombeyata \"figure, doll, dance and performance\".",
          "locator": "para. 1",
          "context": null,
          "evidence": "QUOTED",
          "level": "PROVISIONAL"
        }
      ]
