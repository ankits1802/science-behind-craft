    {
      "id": "s4",
      "field": "CHEMISTRY",
      "title": "Ajrakh through time",
      "sentences": [
        {
          "text": "15th-century resist-printed fragments from Gujarat were found at Fustat in Egypt.",
          "level": "PROVISIONAL",
          "claimIds": [
            "c11f4137-eabe-5a86-91f5-a2a42aba85f2"
          ],
          "sourceIds": [
            "f60ab91b-7057-56fe-a4c0-17664472b776"
          ],
          "cites": [
            5
          ]
        },
        {
          "text": "A legend links the craft to Dhamadka following a 16th-century migration.",
          "level": "PROVISIONAL",
          "claimIds": [
            "77b4e851-c1cd-5561-81a9-018e6e5086a6"
          ],
          "sourceIds": [
            "f60ab91b-7057-56fe-a4c0-17664472b776"
          ],
          "cites": [
            5
          ]
        },
        {
          "text": "After a massive earthquake in 2001 the block printers were forced to relocate and settled in Ajrakhpur; over 100 families live there with 30 official workshops.",
          "level": "PROVISIONAL",
          "claimIds": [
            "bc976cc1-204e-52e8-9b26-f1a91d33b7b3"
          ],
          "sourceIds": [
            "d0f53ee9-4b97-5df7-a367-686957bdb7c8"
          ],
          "cites": [
            2
          ]
        },
        {
          "text": "Rao Bharmalji I (1586-1631) invited Khatri printers from Sindh and gave them land and tax exemptions.",
          "level": "PROVISIONAL",
          "claimIds": [
            "66c8488c-11fe-5f1b-8653-dddbdaef2393"
          ],
          "sourceIds": [
            "56c24809-a5fd-5d90-b6db-e55d7be09c07"
          ],
          "cites": [
            6
          ]
        }
      ],
      "components": [],
