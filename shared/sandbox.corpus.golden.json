  "accepted": [
    {
      "name": "the fixture's generated explainer",
      "html": "<style>\n.kv{display:grid;gap:12px;padding:16px;font:15px/1.5 system-ui,sans-serif;color:#1d1b16;background:#faf7f0}\n.kv label{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center}\n.kv input{width:100%}\n.kv .bar{height:16px;border-radius:8px;background:#e4dccb;overflow:hidden}\n.kv .fill{height:100%;width:0;background:#2f5d8a;transition:width .3s ease}\n.kv .fill.high{background:#8a3b2f}\n</style>\n<div class=\"kv\">\n<label for=\"years\">Years from now <output id=\"count\"></output></label>\n<input id=\"years\" type=\"range\" min=\"1\" max=\"10\" step=\"1\" value=\"1\">\n<div class=\"bar\" role=\"img\" aria-label=\"Fall at the lower stated rate\"><div class=\"fill\" id=\"low\"></div></div>\n<div class=\"bar\" role=\"img\" aria-label=\"Fall at the higher stated rate\"><div class=\"fill high\" id=\"high\"></div></div>\n<p id=\"said\" aria-live=\"polite\"></p>\n</div>\n<script>\nconst data = JSON.parse(document.getElementById(\"kv-data\").textContent);\nconst years = document.getElementById(\"years\");\nfunction draw() {\n  const n = Number(years.value);\n  const most = Number(years.max) * data.fallHighFeet;\n  document.getElementById(\"count\").textContent = String(n);\n  document.getElementById(\"low\").style.width = (n * data.fallLowFeet / most * 100) + \"%\";\n  document.getElementById(\"high\").style.width = (n * data.fallHighFeet / most * 100) + \"%\";\n  document.getElementById(\"said\").textContent = \"The water table is \" + n * data.fallLowFeet + \" to \" + n * data.fallHighFeet + \" feet lower.\";\n}\nyears.addEventListener(\"input\", draw);\ndraw();\n</script>"
    },
    {
      "name": "svg geometry with a gradient fragment",
      "html": "<svg viewBox=\"0 0 320 120\" role=\"img\" aria-label=\"Water table\"><defs><linearGradient id=\"g\"><stop offset=\"0\" stop-color=\"#2f5d8a\"></stop></linearGradient></defs><rect x=\"8\" y=\"8\" width=\"304\" height=\"40\" fill=\"url(#g)\"></rect><circle cx=\"160\" cy=\"80\" r=\"12\"></circle></svg>"
    },
