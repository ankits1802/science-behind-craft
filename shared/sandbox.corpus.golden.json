    },
    {
      "name": "animation from layout constants",
      "html": "<canvas id=\"c\" aria-label=\"Water falling\"></canvas><script>const canvas = document.getElementById(\"c\");const ctx = canvas.getContext(\"2d\");let t = 0;function frame() { t = (t + 1) % 360; ctx.clearRect(0, 0, canvas.width, canvas.height); ctx.fillRect(0, 0, canvas.width * t / 360, 8); requestAnimationFrame(frame); }requestAnimationFrame(frame);</script>"
    }
